# 配置模板 复制为 .env.qa / .env.prod 并填入真实值
# 环境通过启动时的 APP_ENV 环境变量选择(默认qa): APP_ENV=prod python main.py

# local mysql
LOCAL_MYSQL_HOST=
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_USER=
LOCAL_MYSQL_PASSWORD=
LOCAL_MYSQL_DB=

# 千问 API keys
QWEN_API_KEY_1=
QWEN_API_KEY_2=

# 千问模型名 供应商下线模型时改这里即可
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_ASR_MODEL=qwen3-asr-flash
# 思考模式默认关闭 开启后耗时增加 需在实际样本上验证效果
QWEN_ENABLE_THINKING=false
QWEN_THINKING_BUDGET=4096

# 视频切片抽帧 + 语音转写开关(默认开) 关闭后回退整段视频打分
AUDIT_MEDIA_ENABLED=true
# 关键帧: 总帧数上限与长边像素上限 直接影响画面识别粒度与 token 成本
MEDIA_MAX_FRAMES=24
MEDIA_FRAME_WIDTH=1024
# 二次补证: 对证据受限的评分项切连续片段重判(额外一次模型调用) 片段数上限
MEDIA_SUPPLEMENT_ENABLED=true
MEDIA_SUPPLEMENT_CLIPS=6
# 外部 ffmpeg 路径 留空则用 PATH 或 imageio-ffmpeg 内置二进制
FFMPEG_BINARY=

# 规则管理页(/admin/rules)口令 留空则禁用管理页 用户名固定 admin
ADMIN_PASSWORD=

# 阿里云 OSS
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
OSS_BUCKET=wyxtapp
OSS_ENDPOINT=https://oss-cn-chengdu.aliyuncs.com